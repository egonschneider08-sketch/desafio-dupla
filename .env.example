# SQLite local funciona sem DATABASE_URL.
# DATABASE_URL=sqlite:////caminho/absoluto/para/sorvetes.db
# PostgreSQL opcional requer banco, driver e migrações:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/sorvetes

# IMPORTANTE: em produção use APP_ENV=production e SECRET_KEY aleatória persistente
# gerada fora do repositório (ex.: python -c "import secrets; print(secrets.token_hex(32))").
# Nunca comite nem compartilhe a chave.
# APP_ENV=production
# SECRET_KEY=

# Somente desenvolvimento local
# FLASK_DEBUG=1
