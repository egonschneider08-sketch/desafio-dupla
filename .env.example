# SQLite local é o padrão, sem nenhuma variável obrigatória.
# Para forçar um caminho, use uma URL SQLite apropriada ao ambiente:
# DATABASE_URL=sqlite:////caminho/absoluto/para/sorvetes.db

# PostgreSQL opcional, somente após criar o banco e configurar psycopg:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/sorvetes

# Ative apenas durante desenvolvimento local:
# FLASK_DEBUG=1
